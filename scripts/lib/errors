# =============================================================================
# Errors policy:
# - ranges assigned and reserved to specific target(s)
# - ranged errors shall be prefered
# - error values after 100 are reserved for atomic errors
# =============================================================================

# [00-09] Global
readonly ERR_OK=0
readonly ERR_INVALID_ARG=1
readonly ERR_FILE_NOT_FOUND=2

# [10-14] Source available daemon
readonly ERR_SOURCE_CHANGED_EVENT_FAIL=10
readonly ERR_INPUT_STATUS_QUERY=11
readonly ERR_INPUT_STATUS_NO_DATA=12

# [15-19] Negotiate source signal
readonly ERR_READ_FMT_VIDEO=15
readonly ERR_WRITE_PIXEL_FMT=16
readonly ERR_QUERY_TIMINGS=17
readonly ERR_LOCK_SIGNAL=18

# [100+ ] Atomic errors
readonly ERR_VIDEO_DEVICE_NOT_FOUND=100