# common scripts functions
# =============================================================================

# =============================================================================
# Log levels (mapped to syslog/journald priorities):
#   debug    7  Verbose detail; only emitted when DEBUG=1
#   info     6  General operational messages
#   notice   5  Significant but normal events
#   warning  4  Unexpected condition; script continues
#   err      3  Fatal failure; caller should exit immediately
# =============================================================================
log() {
    local LEVEL="$1"
    local MSG="$2"
    if [ "$LEVEL" = "debug" ] && [ "${DEBUG:-0}" != "1" ]; then
        return
    fi

    # $JOURNAL_STREAM is set by systemd only when this process's stderr is connected directly to journald
    if [ -n "${JOURNAL_STREAM:-}" ]; then
        local PRIORITY
        case "$LEVEL" in
            debug)   PRIORITY=7 ;;
            info)    PRIORITY=6 ;;
            notice)  PRIORITY=5 ;;
            warning) PRIORITY=4 ;;
            err)     PRIORITY=3 ;;
            *)       PRIORITY=6 ;;
        esac
        printf "<%d>%s: %s\n" "$PRIORITY" "${LEVEL^^}" "$MSG" >&2
    else
        printf "%s: %s\n" "${LEVEL^^}" "$MSG" >&2
    fi
}

sudo_check() {
    if [ "$EUID" -ne 0 ]; then
        log "err" "Must be run as root: sudo $(basename "$0")"
        exit "$ERR_SUDO"
    fi
}

# =============================================================================
# Wrapper around v4l2-ctl.
# stdout and stderr are suppressed: callers check the exit code and log their own error message.
# =============================================================================
v4l2() {
    v4l2-ctl "$@" >/dev/null 2>&1
}

# =============================================================================
# Generic CLI flag parser.
# Caller pre-declares ARG_MAP (flag -> variable name)
# Any flag present on the command line sets its mapped variable to "true".
#
#   declare -A ARG_MAP=(
#       [--upgrade]="DO_UPGRADE"
#       [--update]="DO_UPDATE"
#   )
#   declare DO_UPGRADE=false
#   declare DO_UPDATE=false
#
#   parse_args "$@"
#
# =============================================================================
parse_args() {
    local ARG
    local VAR_NAME

    for ARG in "$@"; do
        if [[ -v ARG_MAP["$ARG"] ]]; then
            VAR_NAME="${ARG_MAP[$ARG]}"
            declare -g "$VAR_NAME"=true
        else
            log "err" "Unknown option: $ARG"
            exit "$ERR_INVALID_ARG"
        fi
    done
}

# =============================================================================
# Generic command dispatcher.
# Caller pre-declares CMD_MAP (command -> function name).
# Run mapped function for "$1".
#
#   declare -A CMD_MAP=(
#       [wait_for_event]="wait_for_event"
#       [manage_service]="manage_service"
#   )
#
#   dispatch "$@"
#
# =============================================================================
dispatch() {
    local CMD="$1"
    local FN_NAME

    if [[ -z "$CMD" ]]; then
        log "err" "No command given"
        exit "$ERR_INVALID_ARG"
    fi

    if [[ -v CMD_MAP["$CMD"] ]]; then
        FN_NAME="${CMD_MAP[$CMD]}"
        "$FN_NAME"
    else
        log "err" "Unknown command: $CMD"
        exit "$ERR_INVALID_ARG"
    fi
}