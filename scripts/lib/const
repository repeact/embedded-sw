# =============================================================================
# Project constants
# =============================================================================

# Install paths
declare -gr INSTALL_DIR="/etc/repeact"
declare -gr SYSTEMD_DIR="/etc/systemd/system"
declare -gr UDEV_RULES_DIR="/etc/udev/rules.d"
declare -gr SYMLINK_DIR="/usr/local/bin"
declare -gr CONFIG_DIR="$INSTALL_DIR/config"
declare -gr HW_CONFIG_FILE="/boot/firmware/config.txt"

# Pinned dependency
# Hardcoded intentionally: simplified bug tracking
declare -gr PKG_V4L2_UTILS="v4l-utils=1.30.1*"
declare -gr PKG_FFMPEG="ffmpeg=8:7.1*"

# Scripts deployed to $INSTALL_DIR
# (chmod +x + symlinked to $SYMLINK_DIR)
declare -gra EXECUTABLES=(
    "load-edid.sh"
)

# Required dependencies files
declare -gra SOURCES=(
    "lib/common"
    "lib/const"
    "lib/errors"
)

declare -gra SERVICES=(
    "repeact-video0-setup.service"
)

declare -gra RULES=(
    "99-repeact-video0.rules"
)

# Required hardware config
# (DTOs in $HW_CONFIG_FILE)
declare -gra SETTINGS=(
    "camera_auto_detect=0"
    "dtoverlay=tc358743"
    "dtoverlay=cma,cma-128"
    "gpu_mem=128"
)

declare -gr EDID_FILE="edid.hex"
declare -gr VIDEO_DEVICE="/dev/video0"